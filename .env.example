# API
API_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://txnguard:txnguard@localhost:5433/txnguard

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-local-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-local-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Fraud engine
VELOCITY_WINDOW_SECONDS=60
VELOCITY_THRESHOLD=5

# Credential protection
API_KEY_ROTATION_WINDOW_SECONDS=3600
API_KEY_ROTATION_LIMIT=3

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
